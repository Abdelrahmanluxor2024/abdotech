# ==================== SUPABASE CONFIGURATION ====================
# بيانات الاتصال بـ Supabase
# 
# كيف تحصل على هذه البيانات:
# 1. اذهب إلى: https://supabase.com/dashboard/project/firiwczwbakobadvrrom/settings/api
# 2. انسخ "Project URL" من قسم Configuration
# 3. انسخ "anon public" key من قسم Project API keys
#
# ==================== 

# Project URL (من صفحة Settings → API)
# مثال: https://firiwczwbakobadvrrom.supabase.co
SUPABASE_URL=https://firiwczwbakobadvrrom.supabase.co

# Anon/Public Key (من صفحة Settings → API)
# هذا هو المفتاح العام الآمن للاستخدام في المتصفح
# يجب أن يكون JWT طويل يبدأ بـ eyJ...
# مثال: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS...
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Service Role Key (اختياري - للاستخدام في Backend فقط)
# تحذير: لا تستخدم هذا المفتاح في المتصفح! خطير جداً
# SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
